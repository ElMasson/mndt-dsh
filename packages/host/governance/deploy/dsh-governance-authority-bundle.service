[Unit]
Description=DSH governance authority (RBAC for the Duke team)
Documentation=file:///opt/dsh-governance/README-DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/opt/dsh-governance

# Loopback only: TLS and SSO belong to the reverse proxy, and this port must
# never be reachable from the network directly.
Environment=DSH_GOVERNANCE_HOST=127.0.0.1
Environment=DSH_GOVERNANCE_PORT=8787
Environment=DSH_GOVERNANCE_TOKENS_FILE=/etc/dsh/tokens.json
Environment=DSH_GOVERNANCE_STATE=/var/lib/dsh/governance/rbac.json
Environment=DSH_GOVERNANCE_AUDIT=/var/lib/dsh/governance/audit.jsonl

# The bundle is a single file: no package manager, no checkout, no build step.
ExecStart=/usr/bin/node /opt/dsh-governance/governance-authority.mjs
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsh/governance
ReadOnlyPaths=/etc/dsh/tokens.json

[Install]
WantedBy=multi-user.target
