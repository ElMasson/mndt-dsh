# The mndt workbench as a self-contained Linux image.
#
# Stage one reproduces the repository build from a frozen lockfile. Stage two
# carries the built workspace, because pnpm deploy cannot carry a workspace whose
# packages link to each other.
FROM node:22-bookworm AS build
# musl-tools builds the static Landlock launcher (native/system): without it the
# workbench has no sandbox backend and every agent turn fails closed.
RUN apt-get update -qq && apt-get install -y -qq git musl-tools >/dev/null
WORKDIR /src
COPY . /src
RUN npm install -g pnpm@11.28.5 >/dev/null 2>&1
RUN pnpm install --frozen-lockfile
RUN pnpm exec tsx scripts/generate-typert.ts
# The system binaries this platform declares (native/system/packages/<os>-<arch>
# /prebuilds.json): the static landlock-run launcher and the flock addon. The
# artifacts build does not produce the launcher, and DSH refuses to run a
# workflow unconfined (sandbox-unavailable): no launcher, no agent turn.
RUN pnpm exec tsx native/system/scripts/build.ts
RUN node -e "require('node:fs').accessSync('native/system/packages/linux-' + process.arch + '/bin/landlock-run', require('node:fs').constants.X_OK)"
ARG COMMIT=local
ENV DSH_CLIENT_COMMIT_HASH=${COMMIT}
# This fork ships the mndt brand: the window title must not depend on a caller
# spelling DSH_CLIENT_TITLE, and the locale brand string is mndt as well.
ENV DSH_CLIENT_TITLE=mndt
ENV NODE_OPTIONS="--experimental-strip-types --max-old-space-size=6144"
# Print the compiler's own diagnostics when a gate fails, so the build log
# carries the real reason instead of only a summary.
RUN pnpm exec tsx scripts/build.ts --scope artifacts || (echo "=== host compiler errors ==="; pnpm exec tsc -b tsconfig.host.json 2>&1 | head -30; exit 1)
RUN if [ ! -f apps/cli/lib/bin.js ]; then pnpm exec tsdown --config-loader native --env.DSH_BUILD_FACE host --filter @deepseek-ai/dsh; fi
RUN test -f apps/cli/lib/bin.js

FROM node:22-bookworm
# The whole built workspace, node_modules included: pnpm's deploy cannot carry a
# workspace graph whose packages link to each other, and the seed is what makes
# plugin resolution work at runtime.
COPY --from=build /src /app
COPY --from=build /src/packages/host/mndt/deploy/workbench-entrypoint.sh /app/workbench-entrypoint.sh
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=3072
EXPOSE 3111
CMD ["sh", "/app/workbench-entrypoint.sh"]