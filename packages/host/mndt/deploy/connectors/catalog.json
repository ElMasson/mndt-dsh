{
  "_comment": "Read-only connectors of the agentic Slack lot 1. One entry per connector: mount it with `mount-connector.sh <name> --preset`. approvals: MNDT_API stays in approvals.env as deployed today; deciding is denied twice (env and proxy). Secrets never live here: each entry names an env file under /data/mndt/live/connectors, mode 600. allow/deny are tool-name patterns (trailing * = prefix); deny wins. The proxy refuses every tool outside allow before the call reaches the server. Code and dependencies of qonto (mcp-remote, pinned by runtime/qonto.package-lock.json), dolibarr and swing (Python, pinned by runtime/*.requirements.txt) are installed under the tenant's tools folder by tenant/install-connectors.sh; nothing is fetched when the workbench starts. qonto: every tool that answers with a presigned download URL (attachments, statements) is denied.",
  "office365": {
    "command": [
      "node",
      "/opt/mndt-tools/office365-mcp.mjs"
    ],
    "envFile": "office365.env",
    "env": {
      "OFFICE365_MODE": "application",
      "OFFICE365_ALLOWED_DOMAINS": "datanalysis.re",
      "MNDT_ACTOR_FILE": "/state/mission-actor.json"
    },
    "allow": [
      "mail_recent",
      "mail_search",
      "calendar_upcoming"
    ],
    "deny": []
  },
  "qonto": {
    "command": [
      "node",
      "/opt/mndt-tools/qonto/node_modules/mcp-remote/dist/proxy.js",
      "https://mcp.qonto.com/mcp"
    ],
    "envFile": "qonto.env",
    "env": {
      "MCP_REMOTE_CONFIG_DIR": "/state/mcp-auth"
    },
    "allow": [
      "list_*",
      "get_*"
    ],
    "deny": [
      "get_attachment",
      "get_statement",
      "list_statements",
      "list_transaction_attachments"
    ]
  },
  "dolibarr": {
    "command": [
      "python3",
      "-m",
      "dolibarr_mcp.dolibarr_mcp_server"
    ],
    "cwd": "/opt/mndt-tools/dolibarr-mcp",
    "envFile": "dolibarr.env",
    "env": {
      "PYTHONSAFEPATH": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPATH": "/opt/mndt-tools/dolibarr-mcp/src:/opt/mndt-tools/dolibarr-mcp/site"
    },
    "allow": [
      "get_*",
      "search_*",
      "list_*"
    ],
    "deny": [
      "dolibarr_raw_api"
    ]
  },
  "swing": {
    "command": [
      "python3",
      "-m",
      "mcp.swing_mcp"
    ],
    "cwd": "/opt/mndt-tools/swing",
    "envFile": "swing.env",
    "env": {
      "PYTHONSAFEPATH": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPATH": "/opt/mndt-tools/swing/src:/opt/mndt-tools/swing/site"
    },
    "allow": [
      "list_*",
      "get_*",
      "search_*"
    ],
    "deny": [
      "get_rehydration_prompt"
    ]
  },
  "approvals": {
    "command": [
      "node",
      "/opt/mndt-tools/approvals-mcp.mjs"
    ],
    "envFile": "approvals.env",
    "env": {
      "MNDT_ACTOR_FILE": "/state/mission-actor.json",
      "MNDT_APPROVALS_ALLOW_DECIDE": "0"
    },
    "allow": [
      "request_approval",
      "list_pending_approvals",
      "read_approval"
    ],
    "deny": [
      "decide_approval"
    ]
  }
}
