# LLM routes of the workbench. Copy into /data/mndt/live/model.env (mode 600).
# Keys are read per request through apiKeyEnv; they never enter the composition.
SCW_GENAPI_KEY=
VLLM_API_KEY=placeholder
# Non-secret values substituted by render-llm-routes.py:
SCW_PROJECT_ID=
VLLM_QWEN_BASE_URL=http://51.159.151.86:8000/v1
# Read it on the private network: curl -s $VLLM_QWEN_BASE_URL/models | jq -r '.data[].id'
VLLM_QWEN_MODEL=
