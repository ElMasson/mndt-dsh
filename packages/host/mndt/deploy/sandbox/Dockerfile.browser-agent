# An interactive browser session, one per person.
#
# Chromium plus playwright-core and a small control server. The container is
# read only, drops every capability and runs without root: only /tmp and the
# browser's shared memory are writable.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        fonts-liberation \
        fonts-dejavu-core \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN npm init -y >/dev/null 2>&1 \
    && npm install --no-audit --no-fund playwright-core@1.48.2 >/dev/null 2>&1

COPY browser-agent.mjs /app/browser-agent.mjs

ENV HOME=/tmp \
    AGENT_PORT=9223 \
    CHROMIUM_PATH=/usr/bin/chromium

EXPOSE 9223
ENTRYPOINT ["node", "/app/browser-agent.mjs"]
