# The machine service of a team space (machines-sidecar.py): it starts, drives
# and stops the members' computers. Its only way to Docker is the space's guard
# (docker-guard.py, the same image, another entrypoint), which relays only what
# the space's computers need. The service holds no socket and no model key; it
# runs as root inside its own container to hand each member's folder to uid 1000.
# Pinned by digest: the base and the Docker client never change under a rebuild unannounced.
FROM docker:29.1.3-cli@sha256:4fa0ee1f3a7e4354c4ea34558b6d4ee32859baf4973d4c8ccc8e7fe3dd730c04 AS client

FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
COPY --from=client /usr/local/bin/docker /usr/local/bin/docker
COPY machines-sidecar.py docker-guard.py /app/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/app/machines-sidecar.py"]
