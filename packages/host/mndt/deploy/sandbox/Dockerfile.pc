# « Mon ordinateur »: one member's computer, under gVisor (runtime set by the
# sidecar). A screen (Xvfb, openbox, Chromium driven by xdotool), a browser
# (Chromium driven by playwright-core) and a terminal for code (bash, python3,
# node, git, curl). Its two agents listen on the loopback only: the sidecar
# reaches them through `docker exec` of pc-call.mjs, so the computer needs no
# network but its egress proxy. Read-only root, no capability, user 1000; its
# writable places are /tmp, /dev/shm and the member's own files (/home/user).
# Pinned by digest: the computer's base never changes under a rebuild unannounced.
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee

# The packages pinned too: Debian's archive as it was on one date
# (snapshot.debian.org), signed by the keys of the base image. A rebuild a month
# later installs the same versions; a new date is a choice, said in a PR.
ARG DEBIAN_SNAPSHOT=20261120T000000Z
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
        "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        xvfb \
        x11-utils \
        xdotool \
        openbox \
        imagemagick \
        chromium \
        fonts-liberation \
        fonts-dejavu-core \
        ca-certificates \
        bash \
        coreutils \
        procps \
        python3 \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN npm init -y >/dev/null 2>&1 \
    && npm install --no-audit --no-fund playwright-core@1.48.2 >/dev/null 2>&1

COPY browser-agent.mjs desktop-agent.mjs pc-call.mjs pc-entrypoint.sh /app/
RUN chmod +x /app/pc-entrypoint.sh

ENV HOME=/home/user \
    DISPLAY=:99 \
    CHROMIUM_PATH=/usr/bin/chromium \
    AGENT_HOST=127.0.0.1 \
    AGENT_PORT=9223 \
    DESKTOP_HOST=127.0.0.1 \
    DESKTOP_PORT=9224

# The member's uid, also when the image runs without --user.
USER 1000:1000
ENTRYPOINT ["/app/pc-entrypoint.sh"]
