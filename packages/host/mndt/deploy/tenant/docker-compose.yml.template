name: mndt-__SLUG__

# One tenant of the team workbench (agentic Slack, lot 1), rendered by
# create-tenant.sh. Same shape as mndt-front/docker-compose.yml, with every
# name, path and host of the tenant set by the script.

services:
  gateway:
    image: node:22-bookworm-slim
    command: ["node", "/opt/gateway/server.mjs"]
    environment:
      PORT: "8080"
      WORKBENCH: "http://workbench:3111"
      API: "http://workbench:8795"
      # The shell's launch token, in a volume of its own: never under /state,
      # which this gateway no longer mounts at all.
      TOKEN_FILE: "/run/mndt-launch/web-token"
      GATEWAY_SECRET_FILE: "/run/secrets/mndt-gateway"
      # Only requests the sign-on proxy signed are served (oauth2-proxy signature_key).
      PROXY_SIGNATURE_KEY_FILE: "/run/secrets/mndt-proxy-signature"
      # Listen only on the proxy's network: the workbench and its agents find no gateway port.
      LISTEN_ALIAS: "gateway-ingress"
      # The only person who gets the DSH shell (under /dsh/); everyone else, the team page.
      OWNER: __OWNER__
      # The fingerprint of gateway/server.mjs, written by create-tenant.sh: the code
      # is mounted, not built in, so `docker compose up -d` recreates the gateway
      # only because this value changes when the code does.
      MNDT_GATEWAY_CODE: "__GATEWAY_CODE__"
    volumes:
      - __APP__/gateway:/opt/gateway:ro
      - launch:/run/mndt-launch:ro
      - __CONF__/gateway_secret:/run/secrets/mndt-gateway:ro
      - __CONF__/proxy_signature_key:/run/secrets/mndt-proxy-signature:ro
    networks:
      front: {}
      ingress:
        aliases: [gateway-ingress]
    restart: unless-stopped

  proxy:
    image: quay.io/oauth2-proxy/oauth2-proxy:v7.15.5
    command:
      - "--config=/etc/mndt-front/oauth2.cfg"
      - "--client-secret-file=/etc/mndt-front/client_secret"
      - "--cookie-secret-file=/etc/mndt-front/cookie_secret"
      - "--trusted-proxy-ip=__TRUSTED_PROXY__"
    # OAUTH2_PROXY_SIGNATURE_KEY (sha256:<key>): the proxy signs each request it
    # relays; the value stays in a 0400 file, never in this compose.
    environment:
      # The fingerprint of oauth2.cfg and of the sign-in list, written by
      # create-tenant.sh: `up -d` recreates the proxy when either changed (it
      # reads the configuration once; it also watches the list).
      MNDT_PROXY_CONF: "__PROXY_CONF__"
    env_file:
      - __CONF__/proxy_signature.env
    volumes:
      - __CONF__:/etc/mndt-front:ro
    labels:
      traefik.enable: "true"
      traefik.docker.network: "__TRAEFIK_NETWORK__"
      traefik.http.routers.mndt-__SLUG__.rule: "Host(`__DOMAIN__`)"
      traefik.http.routers.mndt-__SLUG__.entrypoints: "websecure"
      traefik.http.routers.mndt-__SLUG__.tls.certresolver: "letsencrypt"
      traefik.http.services.mndt-__SLUG__.loadbalancer.server.port: "4180"
    networks:
      - ingress
      - edge
    depends_on:
      - gateway
    restart: unless-stopped

  workbench:
    image: __IMAGE__
    # The gateway is the only ingress: no public port.
    env_file:
      - __DATA__/model.env
    environment:
      DSH_HOME: /state/home
      # Where the entrypoint publishes the shell's launch token for the gateway:
      # outside /state, in the `launch` volume only the gateway shares.
      DSH_MNDT_WEB_TOKEN_FILE: /run/mndt-launch/web-token
      # The shell's log prints that token too: kept beside it, never under /state.
      DSH_MNDT_WEB_LOG: /run/mndt-launch/web.log
      # What an agent's commands may read: the system and the image, and four
      # device files; never /state (secrets, roles, other channels, sessions),
      # /opt/mndt-tools (the tools folder is mounted from inside /state and holds
      # connector data such as facts.md; the MCP servers run outside the sandbox),
      # /run (the shell's launch token and its log, the gateway secret), /root,
      # /tmp (other sessions' output), /proc (the other processes' environment
      # holds the model keys) nor the rest of /dev (the owner's terminals). They
      # write in their channel's folder and their session's private temp, which is
      # also their HOME, with an allow-listed environment. Fails closed (sandbox-local).
      DSH_SANDBOX_READ_ROOTS: "/usr:/lib:/lib64:/bin:/sbin:/etc:/app:/dev/null:/dev/zero:/dev/urandom:/dev/random"
      # The organisation the team screen names, and its environment when declared.
      DSH_MNDT_ORG_SLUG: __SLUG__
      DSH_MNDT_ORG_NAME: "__ORG_NAME__"
      DSH_MNDT_ENV: "__ENV__"
      # The gateway's secret (create-tenant.sh, outside /state): the API believes
      # the proxy identity header only on a request that carries it.
      DSH_MNDT_GATEWAY_SECRET_FILE: /run/secrets/mndt-gateway
      # Same for the tools folder (entrypoint and connector tools), run from disk
      # rather than the image: one fingerprint of everything create-tenant.sh puts there.
      MNDT_TOOLS_CODE: "__TOOLS_CODE__"
      DSH_MNDT_IDENTITY: __OWNER__
      DSH_MNDT_LOCAL_OWNER: __OWNER__
      DSH_MNDT_STATE: /state/state.json
      # The date and time every prompt opens with (the container's clock is UTC).
      DSH_MNDT_TIME_ZONE: Indian/Reunion
      DSH_MNDT_PORT: "8795"
      # The API must listen on the container's network, or the gateway (another
      # container) is refused and every /mndt-api call answers 502. The front
      # network is not published: only the gateway reaches it.
      DSH_MNDT_HOST: 0.0.0.0
      DSH_MNDT_TOKENS_FILE: /state/tokens.json
      DSH_MNDT_PROXY_USER_HEADER: x-forwarded-email
      # The tenant's role table, read on every request (create-tenant.sh writes it with the owner).
      DSH_MNDT_GRANTS_FILE: /state/grants.json
      # The space's models by role (create-tenant.sh writes the default policy), read at each turn.
      DSH_MNDT_MODEL_ROLES_FILE: /state/roles.json
      # A message never decides: the approvals connector never offers decide_approval.
      MNDT_APPROVALS_ALLOW_DECIDE: "0"
      # The shell's address: its name on the front network only.
      WEB_HOST_ALIAS: workbench-front
      # The machine service: the members' computers (« Mon ordinateur »).
      MNDT_MACHINES_URL: http://machines-api:8796
      MACHINES_TOKEN_FILE: /run/secrets/mndt-machines
      PUBLIC_URL: https://__DOMAIN__/
      TRUSTED_HOST: __DOMAIN__
    command: ["sh", "/opt/mndt-tools/workbench-entrypoint.sh"]
    volumes:
      - __DATA__:/state
      - __DATA__/tools:/opt/mndt-tools:ro
      - __DATA__/mcp-auth:/state/mcp-auth
      - __CONF__/gateway_secret:/run/secrets/mndt-gateway:ro
      # The machine service's token, outside /state (an agent's sandbox reads
      # neither /state nor /run): the API alone asks the sidecar for a computer.
      - __CONF__/machines_token:/run/secrets/mndt-machines:ro
      - launch:/run/mndt-launch
    networks:
      # The shell binds its address on this network (WEB_HOST_ALIAS, resolved by
      # the entrypoint): with two networks, `hostname -i` may name the other one,
      # which the gateway cannot reach.
      front:
        aliases: [workbench-front]
      machines: {}
    restart: unless-stopped

  # « Mon ordinateur »: the members' computers, one each, under gVisor. The
  # sidecar builds every `docker run` itself (no request field reaches a flag)
  # and serves only the computers (MACHINES_PC_ONLY): no capture, no session
  # browser or desktop, no shell. It listens on the machines network only. It
  # runs as root in its own container (no socket, no capability needed beyond
  # handing each member's folder to uid 1000); Docker answers it only through
  # the guard.
  machines:
    image: __MACHINES_IMAGE__
    environment:
      MACHINES_TOKEN_FILE: /run/secrets/mndt-machines
      MACHINES_HOST: machines-api
      MACHINES_PORT: "8796"
      MACHINES_PC_ONLY: "1"
      MNDT_MACHINE_RUNTIME: runsc
      PC_IMAGE: __PC_IMAGE__
      # This space's computers, networks and places, never another space's on the host.
      PC_TENANT: __SLUG__
      PC_PREFIX: mndt-__SLUG__-pc-
      PC_NET_PREFIX: mndt-__SLUG__-pcnet-
      USERS_ROOT: /users
      # Docker resolves a bind on the host: the same folder, by its host path.
      USERS_ROOT_HOST: __DATA__/users
      EGRESS_PROXY: mndt-__SLUG__-egress
      EGRESS_PORT: "3128"
      DOCKER_HOST: tcp://docker-guard:2375
    volumes:
      - __CONF__/machines_token:/run/secrets/mndt-machines:ro
      - __DATA__/users:/users
    networks:
      machines:
        aliases: [machines-api]
      docker-guard-net: {}
    depends_on:
      - docker-guard
      - egress
    restart: unless-stopped

  # The machine service's only way to Docker: our own guard (sandbox/docker-guard.py),
  # which relays only what this space's computers need, every request checked
  # (the computer's image under runsc, the space's label, names and network,
  # one bind under the members' folders; acts only on the space's containers;
  # the egress proxy the only container that joins a computer's network), and
  # answers 403 to everything else. Non-root, in the socket's group, read-only,
  # without capabilities, on a network only the machine service joins.
  docker-guard:
    image: __MACHINES_IMAGE__
    entrypoint: ["python3", "/app/docker-guard.py"]
    user: "65534:__DOCKER_GID__"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    environment:
      MNDT_GUARD_SPACE: __SLUG__
      MNDT_GUARD_PC_IMAGE: __PC_IMAGE__
      MNDT_GUARD_PC_PREFIX: mndt-__SLUG__-pc-
      MNDT_GUARD_NET_PREFIX: mndt-__SLUG__-pcnet-
      MNDT_GUARD_USERS_ROOT: __DATA__/users
      MNDT_GUARD_EGRESS: mndt-__SLUG__-egress
    volumes:
      # The socket itself: Docker's API is read and written through it (a `:ro`
      # on a socket protects nothing). The guard is what bounds it.
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - docker-guard-net
    restart: unless-stopped

  # The computers' only way out: the public web over HTTP and HTTPS. The sidecar
  # attaches it to each computer's internal network (its fixed name). Refused:
  # every private, local and metadata address, and EGRESS_DENY (this host's
  # addresses, Docker's address pools), resolved once and checked.
  egress:
    image: node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
    container_name: mndt-__SLUG__-egress
    command: ["node", "/opt/egress/egress-proxy.mjs"]
    user: "1000:1000"
    read_only: true
    environment:
      EGRESS_PORT: "3128"
      EGRESS_DENY: "__EGRESS_DENY__"
      # The fingerprint of egress-proxy.mjs (create-tenant.sh): `up -d` recreates the proxy when its code changed.
      MNDT_EGRESS_CODE: "__EGRESS_CODE__"
    volumes:
      - __APP__/egress:/opt/egress:ro
    networks:
      - egress-out
    restart: unless-stopped
volumes:
  # The shell's launch token, shared by the workbench (writes) and the gateway (reads).
  launch: {}
networks:
  front: {}
  # The sign-on proxy and the gateway only: the workbench is not on it.
  ingress:
    internal: true
  edge:
    external: true
    name: __TRAEFIK_NETWORK__
  # The API and the sidecar: nothing else reaches the machine service.
  machines:
    internal: true
  # The machine service and its Docker guard only.
  docker-guard-net:
    internal: true
  # The egress proxy's own way to the web; the computers never join it.
  egress-out: {}
